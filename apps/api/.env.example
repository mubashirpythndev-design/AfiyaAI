# Afiya AI Backend Environment Variables
# Copy to .env and fill in your values

# Google Gemini API Key (for LLM orchestration and Gemini embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# OCR model settings are separate from chat. Argon requires a paid API project.
GEMINI_OCR_MODEL=models/gemini-4-argon
GEMINI_OCR_FALLBACK_MODELS=models/gemini-3.1-pro-preview,models/gemini-3.8-flash
OCR_THINKING_LEVEL=medium
# A scan has at most four provider attempts, including failed attempts and audit.
OCR_REQUEST_TIMEOUT_SECONDS=90
OCR_TOTAL_TIMEOUT_SECONDS=150
# Interactive auto/fast scans use the smaller of these and the limits above.
OCR_AUTO_TIMEOUT_SECONDS=65
OCR_AUTO_REQUEST_TIMEOUT_SECONDS=40
OCR_AUTO_REVIEW_TIMEOUT_SECONDS=15
OCR_RETRY_TIMEOUT_SECONDS=12
# True restores coverage reads even for clear, count-complete auto scans.
OCR_AUTO_VERIFY_CLEAR=false

# PostgreSQL Database URL (Neon serverless PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://neondb_owner:password@ep-host.aws.neon.tech/neondb?ssl=require

# Frontend URL (for CORS allowance)
FRONTEND_URL=http://localhost:3000

# Embedding dimensions (768 for Gemini text-embedding-004)
EMBEDDING_DIMENSIONS=768

# Application JWT secret for Afiya HS256 tokens (set a secure random string in production)
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Comma-separated list of administrative email addresses allowed access to /api/admin
ADMIN_EMAILS=admin@example.com, developer@example.com

# Clerk Authentication (RS256 JWKS verification & Clerk Backend API)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# Optional: Clerk token verification overrides
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_AUDIENCE=your_clerk_audience
